{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2022",
    "sourceMap": true,
    "outDir": "./dist",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "moduleResolution": "bundler",
    // Why `bundler` (issue #156): the legacy `node` (node10) algorithm is a
    // deprecation error in TS 6 and REMOVED in TS 7 (TS5108). `bundler` with
    // `module: "commonjs"` is accepted by both, resolves package `exports`
    // under the `require` condition (e.g. drizzle-orm -> `.d.cts`, matching
    // what Node's `require` actually loads), and emits byte-identical JS to
    // node10. Set explicitly: both compilers default to it for commonjs, but
    // an implicit default can move. Do not reintroduce `node`/node10 or an
    // `ignoreDeprecations` escape hatch. `node16`/`nodenext` were rejected:
    // they change emit (native `import()` inside CJS output, ioredis interop).
    // Known gap: `bundler` typechecks an import of an `import`-only (ESM-only)
    // package that `require()` rejects at runtime -- `npm run check:build`'s
    // boot check matches ERR_PACKAGE_PATH_NOT_EXPORTED/ERR_REQUIRE_ESM for it.
    "strict": true,
    "strictPropertyInitialization": false,
    "types": ["node", "jest"]
  },
  "include": ["src/**/*", "test/**/*"],
  "exclude": ["node_modules", "dist"]
}
