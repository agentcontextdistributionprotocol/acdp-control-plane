# E2E-only variables for e2e/run-e2e.sh + e2e/docker-compose.e2e.yml.
# Copy (or append) into the REPO-ROOT .env — see e2e/README.md "Running it".
# Every value except the LLM key has a default in docker-compose.e2e.yml; the
# commented lines show those defaults.

# --- LLM (playground agents) — REQUIRED: set the key for LLM_PROVIDER ---
OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# LLM_PROVIDER=openai
# LLM_MODEL=gpt-4o-mini

# --- Shared HMAC secret (CP ingest, both registries, playground) ---
# WEBHOOK_SECRET=playground-dev-secret

# --- Control plane ---
# CP_API_KEY=e2e-cp-key
# CP_LOG_LEVEL=info

# --- Registries (base64 JWT secret, >= 32 bytes decoded) ---
# ACDP_REGISTRY_JWT_SECRET=cGxheWdyb3VuZC1zZWNyZXQtMzItYnl0ZXMtb2YtdGVzdC1qd3Q=

# --- Playground logging ---
# LOG_FORMAT=pretty
# LOG_LEVEL=INFO
