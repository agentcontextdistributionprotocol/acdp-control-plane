# --- HTTP server ---
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
# The externally-resolvable host (`example.com` or `example.com:8443`) this
# control plane is reachable at — the DNS name a consumer's did:web resolver
# hits for `/.well-known/did.json`. Distinct from HOST (bind address) and
# JWT_AUTHORITY (IdP issuer id). Set it in any deployment that serves a did:web
# witness (WITNESS_ID): the witness did:web↔host binding is asserted against it
# at boot. Empty = the binding check only warns instead of failing.
PUBLIC_HOST=

# --- Database ---
# Matches the compose Postgres (`docker compose up -d postgres`: user/password
# acdp/acdp). Unset entirely, the code defaults to
# postgres://postgres:postgres@localhost:5432/acdp_control_plane.
DATABASE_URL=postgres://acdp:acdp@localhost:5432/acdp_control_plane
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30000
# Checkout + connect timeout (ms). Must be an integer > 0: 0 would disable
# pg-pool's timeouts (unbounded waits) and fails startup (#210).
DB_POOL_CONNECTION_TIMEOUT=5000
# GET /readyz database probe (#210): deadline for SELECT 1 (ms, 50-30000) and
# how long a verdict is reused (ms, 0-60000; 0 = no cache, still single-flight).
# With the 1000 ms default, give a k8s readinessProbe timeoutSeconds >= 2.
READINESS_DB_TIMEOUT_MS=1000
READINESS_CACHE_MS=1000

# --- Auth ---
# Comma-separated API keys. Empty in dev = auth disabled.
AUTH_API_KEYS=
# Subset of AUTH_API_KEYS allowed admin operations (revoke any jti, reload
# pinned keys, enroll registries, ...). Empty = no admin API keys.
# AUTH_ADMIN_API_KEYS=
# Per-tenant API keys: tenantId:key,tenantId:key,bareKey (a bare key binds to
# `default`). See docs/TENANCY.md.
# TENANT_API_KEYS=
# Agent -> tenant mapping stamped as the `tenant` claim on issued JWTs:
# tenantId:did:web:...,tenantId:did:key:...
# TENANT_AGENTS=
# Auth-store backend: memory | postgres (postgres required for multi-replica).
# AUTH_PERSISTENCE=memory
# AUTH_SWEEP_INTERVAL_SECONDS=300

# Strict tenant mode (mirror of the registry's auth.require_tenant). When
# true, every authenticated request MUST resolve to an explicit, non-`default`
# tenant (JWT `tenant` claim, or an API key bound in TENANT_API_KEYS) or it is
# rejected. A spoofable X-Tenant-Id header alone never satisfies it. Default
# false = legacy silent-`default` fallback. Turn on for multi-tenant deploys.
# NOTE: configuring TENANT_AGENTS or a tenant-bound TENANT_API_KEYS entry while
# this is false now fails startup (multi-tenant fail-fast) — set it true.
AUTH_REQUIRE_TENANT=false
# Who may assert a tenant via X-Tenant-Id on a JWT WITHOUT a `tenant` claim:
#   none (default) -> 403 TENANT_HEADER_UNTRUSTED; any_peer -> honour the header
#   (only behind a gateway that authenticates callers and sets it). Mirrors the
#   registry's tenant_header_trust (0.4.0 default none).
# TENANT_HEADER_TRUST=none

# --- Token issuance (IdP: /auth/challenge + /auth/token) ---
# TOKEN_ISSUANCE_ENABLED=false
# HS256 | EdDSA. HS256 needs JWT_SECRET (>= 32 bytes); EdDSA needs
# JWT_PRIVATE_KEY_PEM (public half served at /.well-known/jwks.json).
# JWT_SIGNING_ALG=HS256
# JWT_SECRET=
# JWT_PRIVATE_KEY_PEM=
# Empty = derived from the key fingerprint.
# JWT_KID=
# JWT_AUTHORITY=control-plane.local
# Defaults to JWT_AUTHORITY.
# JWT_AUDIENCE=control-plane.local
# JWT_TTL_SECONDS=3600
# CHALLENGE_TTL_SECONDS=300
# Agent public keys for challenge verification: did=B64KEY[:alg][:from..until],...
# CONTROL_PLANE_PINNED_KEYS=

# --- Policy / quota ---
# static | opa
# POLICY_BACKEND=static
# OPA_URL=http://localhost:8181
# OPA_PACKAGE_PATH=acdp/policy/v1
# OPA_TIMEOUT_MS=1500
# OPA_FAIL_OPEN=false
# Per-tenant per-action windowed quotas; format in docs/POLICY.md. Empty = none.
# TENANT_QUOTAS=

# --- Federation (trusted issuers + cross-issuer revocation) ---
# Peer issuers whose JWTs this control plane accepts. Comma-separated:
#   HS256: <iss>|HS256|<shared-secret>|<audience>[|scope[|flags]]
#   EdDSA: <iss>|EdDSA|<jwks-url>|<audience>[|scope[|flags]]
# `flags` (optional, closed set): `read_only` = this peer's tokens may only use
# GET/HEAD/OPTIONS. Empty scope to set it alone: <iss>|HS256|<secret>|<aud>||read_only
# `audience` is REQUIRED: a peer binds its tokens' `aud` to its own authority
# as a replay defense, so set audience=<that peer's authority>. Empty = no
# federation. See src/auth/trusted-issuers.ts.
TRUSTED_ISSUERS=
# Peer /auth/revocations feeds this CP polls so a token a trusted issuer
# revokes is rejected here before its natural expiry (reciprocal of the feed
# this CP serves). Comma-separated:
#   <issuer>|<feed_url>|<admin_token>[|poll_seconds]
# `issuer` must match a TRUSTED_ISSUERS `iss`; `admin_token` is an admin api
# key on the peer; poll_seconds defaults to 300. Only runs when token
# issuance is enabled (TOKEN_ISSUANCE_ENABLED). See src/auth/revocation-feeds.ts.
REVOCATION_FEEDS=

# --- Ingest ---
# HMAC-SHA256 secret used to verify incoming registry webhooks. Empty = skip (dev).
WEBHOOK_SECRET=
# Accept only enrolled registry authorities.
# INGEST_REQUIRE_ENROLLMENT=false
# An unenrolled authority may not assert a non-default tenant via X-Tenant-Id.
# INGEST_STRICT_TENANT=false
# Raw body cap (bytes) and JSON nesting-depth cap.
# INGEST_MAX_BODY_BYTES=1048576
# INGEST_MAX_JSON_DEPTH=64
# Comma-separated domain packs (e.g. finance); gates custom context_types.
# DOMAIN_PACKS=

# --- Outbound webhooks ---
# Retry sweep interval (ms); <= 0 disables it.
# WEBHOOK_RETRY_INTERVAL_MS=300000
# Relax the subscriber-URL SSRF policy (dev/testing only).
# WEBHOOK_SSRF_ALLOW_HTTP=false
# WEBHOOK_SSRF_ALLOW_LOOPBACK=false

# --- Routing ---
# Bandit router exploration fraction (0..1).
# BANDIT_EXPLORATION_FRACTION=0.05

# --- Playground ---
PLAYGROUND_URL=

# --- Stream hub ---
STREAM_HUB_STRATEGY=memory
REDIS_URL=
STREAM_SSE_HEARTBEAT_MS=15000
# retry: hint (ms, 0-60000) on the terminal SSE `event: shutdown` sent during a graceful drain.
STREAM_SSE_SHUTDOWN_RETRY_MS=1000

# --- Graceful shutdown (issue #192) ---
# Max ms the graceful close may take before lingering sockets are dropped and the
# process exits 1. Integer >= 1000; keep below the platform's termination grace period.
SHUTDOWN_TIMEOUT_MS=10000
# Retry-After (seconds, 1-300) on the 503 SERVICE_DRAINING sent to new requests during a drain.
SHUTDOWN_RETRY_AFTER_SECONDS=1
# Opt-in pre-close drain delay (ms, integer >= 0; 0 = off, the default). On a signal,
# /readyz answers 503 SERVICE_DRAINING for this long while every other route keeps
# serving, so a load balancer can deregister the instance before the listener closes.
# Behind a LB on Kubernetes try ~5000 (and terminationGracePeriodSeconds >=
# (DELAY + TIMEOUT)/1000 + 5). Keep 0 for local dev: ctrl-c twice skips it anyway.
SHUTDOWN_DRAIN_DELAY_MS=0

# --- Throttler ---
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=200
# Unauthenticated IPv6 callers are keyed on this prefix (1-128). 128 = per-address.
THROTTLE_IPV6_SUBNET_PREFIX=64
# Reverse-proxy trust (Express `trust proxy`). Unset = off. A hop count (1-10)
# or a comma list of loopback|linklocal|uniquelocal / IPs / CIDRs. `true` is
# rejected: it lets any client choose its own X-Forwarded-For (throttle evasion).
# TRUST_PROXY=1

# --- Data retention ---
DATA_RETENTION_ENABLED=false
DATA_RETENTION_TTL_DAYS=30
DATA_RETENTION_INTERVAL_HOURS=24

# --- Receipt audit (ACDP 0.2.0, RFC-ACDP-0010) ---
# Background second-observer verification of registry receipts on ingested
# publish events: structural cross-checks + full signature verification
# (the receipt API of the pinned `acdp` ^0.14.4 binding; feature-detected at
# boot, degrades to structural-only if the binding lacks it). Retired registry receipt keys
# (RFC-ACDP-0010 §9) verify as `verified_historical`.
RECEIPT_AUDIT_ENABLED=false
RECEIPT_AUDIT_INTERVAL_SECONDS=300
RECEIPT_AUDIT_BATCH_SIZE=50
RECEIPT_AUDIT_LOOKBACK_HOURS=24

# --- Transparency-log checkpoint witness (ACDP 0.3.0 Tier 3, RFC-ACDP-0012) ---
# The control plane as an external witness/monitor: polls GET /log/checkpoint
# on enrolled registries advertising acdp-registry-transparency-log, verifies
# checkpoint signatures + consistency proofs against retained tree heads, and
# alerts (metric + SSE `log_witness_alert` + outbound webhook) on root
# rewrites, split views, tree-size regressions, and log resets.
LOG_WITNESS_ENABLED=false
LOG_WITNESS_INTERVAL_SECONDS=300
# Comma-separated registry authorities to never witness (per-registry opt-out).
LOG_WITNESS_EXCLUDE_AUTHORITIES=

# --- Transparency-log witness COSIGNING (ACDP 0.4.0, RFC-ACDP-0015) ---
# Evolves the checkpoint witness above from detect-only into a COSIGNING witness:
# a checkpoint that passes the §7 obligation (signature + consistency from the
# retained head) is cosigned with the witness's OWN Ed25519 assertionMethod key
# and served at GET /log/witness (+ /.well-known/{did.json,acdp-witness.json}).
# Requires LOG_WITNESS_ENABLED=true. A checkpoint that FAILS the obligation is
# never cosigned. The witness key is DEDICATED — never the JWT IdP key (§5/§15).
WITNESS_COSIGNING_ENABLED=false
# The witness's DID (did:web:<this-CP-host> or did:key). Required when enabled.
WITNESS_ID=
# PEM-encoded Ed25519 private key (e.g. `openssl genpkey -algorithm ed25519`).
# Required when enabled. Multi-line: quote/escape per your process manager.
WITNESS_SIGNING_PRIVATE_KEY_PEM=
# assertionMethod key id (DID URL under WITNESS_ID). Defaults to
# `<WITNESS_ID>#witness-key-1`.
WITNESS_KEY_ID=
# Per §4/§8.1/§15 the witness re-mints a FRESH cosignature on EVERY observation
# (incl. an unchanged tree_size, as a liveness signal) — log_cosignatures gains
# one row per sweep, not per head. Retention keeps this many rows per
# (tenant, witness, log, head) tuple: the newest N-1 plus the single OLDEST row
# unconditionally (§8.1 anti-backdating — never purge from the ends). Only runs
# when data retention is enabled (DATA_RETENTION_ENABLED).
WITNESS_COSIGNATURE_KEEP_PER_HEAD=10

# --- Transparency-log witness quorum CONSUMPTION (ACDP 0.4.0, RFC-ACDP-0015 §8) ---
# The mirror of cosigning: instead of MINTING, evaluate the N-witnessed quorum
# over the cosignatures a registry AGGREGATES and serves on GET /log/checkpoint
# (the top-level `witness_signatures` sibling). Each is verified against its
# witness's OWN key: a did:key witness is decoded locally (no fetch); a did:web
# witness's DID document is resolved (a key retired from assertionMethod but kept
# in verificationMethod still verifies, counted separately as historical).
# DISTINCT trusted witnesses over the exact (log_id, tree_size, root_hash) tuple
# are counted and recorded on the witnessed head. Requires LOG_WITNESS_ENABLED=true (rides the same fetch).
WITNESS_QUORUM_ENABLED=false
# Comma-separated witness DIDs (did:web / did:key) whose cosignatures count.
# A cosignature from any witness NOT listed is verified-but-ignored.
WITNESS_QUORUM_TRUSTED=
# The N in "N-witnessed": meets_quorum flips true at this many DISTINCT trusted
# witnesses over the head tuple.
WITNESS_QUORUM_MIN_WITNESSES=1
# §8.1 freshness split: fresh_witnessed_count/meets_fresh_quorum count only
# cosignatures also within this many seconds of now. A stale-but-valid
# cosignature still counts toward witnessed_count/meets_quorum — this is a
# SOFT overlay, never a failure. Set to empty or 0 to disable the split
# entirely (every verified cosignature also counts as fresh).
WITNESS_QUORUM_MAX_AGE_SECONDS=300
# §8 step 5 HARD future-dating gate: a cosignature claiming a witnessed_at
# further than this into the future is rejected outright — never counted at
# all, same category as an invalid signature.
WITNESS_QUORUM_MAX_CLOCK_SKEW_SECONDS=120

# Receipt <-> log inclusion cross-check (RFC-ACDP-0012 §9.1): for stored
# publish events with receipts from log-advertising registries, fetch
# /log/proof?ctx_id=... and verify inclusion against a verified checkpoint.
LOG_INCLUSION_AUDIT_ENABLED=false
LOG_INCLUSION_AUDIT_INTERVAL_SECONDS=300
LOG_INCLUSION_AUDIT_BATCH_SIZE=50
LOG_INCLUSION_AUDIT_LOOKBACK_HOURS=24

# --- Producer key-revocation signal (RFC-ACDP-0014) ---
# When enabled, the receipt-audit sweep additionally classifies each audited
# event under any applicable `key-revocation` context published for the same
# producer key (§7): a receipt-attested publish before the revocation's
# compromised_since boundary is historically authorized; at/after it, or
# unverifiable, fails closed. Requires RECEIPT_AUDIT_ENABLED=true.
KEY_REVOCATION_CHECK_ENABLED=false
# How far a registry-attested (not producer-signed) revocation reaches:
# same_registry (default, checked via the §6 registry-binding check),
# global (every registry), or off (ignore registry-attested revocations —
# producer-signed ones still apply either way).
KEY_REVOCATION_ATTESTED_SCOPE=same_registry
# Comma-separated fingerprints that never disarm producer trust (§13 operator
# override), even if named by a revocation.
KEY_REVOCATION_IGNORE_FINGERPRINTS=
# How far back the revocation-discovery sweep looks. NOT the same default as
# RECEIPT_AUDIT_LOOKBACK_HOURS (24h) — revocations are irreversible (§4), so
# a longer window avoids a registry outage silently losing one.
KEY_REVOCATION_LOOKBACK_HOURS=720
# Freshness window for the §7 lineage walk's "fully walked" marker. A re-walk
# cadence knob only: a lineage with zero recorded facts is walked every pass
# regardless. Default 1h matches the DID resolver's document cache. 0 = always
# re-walk (ignore cursors); negative values are rejected at boot.
KEY_REVOCATION_LINEAGE_CURSOR_TTL_HOURS=1

# --- OpenTelemetry / logging ---
LOG_LEVEL=info
OTEL_ENABLED=false
OTEL_SERVICE_NAME=acdp-control-plane
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Swagger ---
# Default: true when NODE_ENV=development, false otherwise.
# SWAGGER_ENABLED=true
# SWAGGER_PATH=docs

NODE_ENV=development
