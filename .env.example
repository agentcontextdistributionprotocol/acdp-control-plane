# --- HTTP server ---
PORT=3001
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:3000
# The externally-resolvable host (`example.com` or `example.com:8443`) this
# control plane is reachable at — the DNS name a consumer's did:web resolver
# hits for `/.well-known/did.json`. Distinct from HOST (bind address) and
# JWT_AUTHORITY (IdP issuer id). Set it in any deployment that serves a did:web
# witness (WITNESS_ID): the witness did:web↔host binding is asserted against it
# at boot. Empty = the binding check only warns instead of failing.
PUBLIC_HOST=

# --- Database ---
DATABASE_URL=postgres://postgres:postgres@localhost:5432/acdp_control_plane
DB_POOL_MAX=20
DB_POOL_IDLE_TIMEOUT=30000
DB_POOL_CONNECTION_TIMEOUT=5000

# --- Auth ---
# Comma-separated API keys. Empty in dev = auth disabled.
AUTH_API_KEYS=

# Strict tenant mode (mirror of the registry's auth.require_tenant). When
# true, every authenticated request MUST resolve to an explicit, non-`default`
# tenant (JWT `tenant` claim, or an API key bound in TENANT_API_KEYS) or it is
# rejected. A spoofable X-Tenant-Id header alone never satisfies it. Default
# false = legacy silent-`default` fallback. Turn on for multi-tenant deploys.
# NOTE: configuring TENANT_AGENTS or a tenant-bound TENANT_API_KEYS entry while
# this is false now fails startup (multi-tenant fail-fast) — set it true.
AUTH_REQUIRE_TENANT=false

# --- Federation (trusted issuers + cross-issuer revocation) ---
# Peer issuers whose JWTs this control plane accepts. Comma-separated:
#   HS256: <iss>|HS256|<shared-secret>|<audience>[|scope]
#   EdDSA: <iss>|EdDSA|<jwks-url>|<audience>[|scope]
# `audience` is REQUIRED: a peer binds its tokens' `aud` to its own authority
# as a replay defense, so set audience=<that peer's authority>. Empty = no
# federation. See src/auth/trusted-issuers.ts.
TRUSTED_ISSUERS=
# Peer /auth/revocations feeds this CP polls so a token a trusted issuer
# revokes is rejected here before its natural expiry (reciprocal of the feed
# this CP serves). Comma-separated:
#   <issuer>|<feed_url>|<admin_token>[|poll_seconds]
# `issuer` must match a TRUSTED_ISSUERS `iss`; `admin_token` is an admin api
# key on the peer; poll_seconds defaults to 300. Only runs when
# TOKEN_ISSUANCE_ENABLED=true. See src/auth/revocation-feeds.ts.
REVOCATION_FEEDS=

# --- Ingest ---
# HMAC-SHA256 secret used to verify incoming registry webhooks. Empty = skip (dev).
WEBHOOK_SECRET=

# --- Playground ---
PLAYGROUND_URL=

# --- Stream hub ---
STREAM_HUB_STRATEGY=memory
REDIS_URL=
STREAM_SSE_HEARTBEAT_MS=15000

# --- Throttler ---
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=200

# --- Data retention ---
DATA_RETENTION_ENABLED=false
DATA_RETENTION_TTL_DAYS=30
DATA_RETENTION_INTERVAL_HOURS=24

# --- Receipt audit (ACDP 0.2.0, RFC-ACDP-0010) ---
# Background second-observer verification of registry receipts on ingested
# publish events: structural cross-checks + full signature verification
# (the `acdp` 0.5.0+ receipt API; feature-detected at boot, degrades to
# structural-only on an older binding). Retired registry receipt keys
# (RFC-ACDP-0010 §9) verify as `verified_historical`.
RECEIPT_AUDIT_ENABLED=false
RECEIPT_AUDIT_INTERVAL_SECONDS=300
RECEIPT_AUDIT_BATCH_SIZE=50
RECEIPT_AUDIT_LOOKBACK_HOURS=24

# --- Transparency-log checkpoint witness (ACDP 0.3.0 Tier 3, RFC-ACDP-0012) ---
# The control plane as an external witness/monitor: polls GET /log/checkpoint
# on enrolled registries advertising acdp-registry-transparency-log, verifies
# checkpoint signatures + consistency proofs against retained tree heads, and
# alerts (metric + SSE `log_witness_alert` + outbound webhook) on root
# rewrites, split views, tree-size regressions, and log resets.
LOG_WITNESS_ENABLED=false
LOG_WITNESS_INTERVAL_SECONDS=300
# Comma-separated registry authorities to never witness (per-registry opt-out).
LOG_WITNESS_EXCLUDE_AUTHORITIES=

# --- Transparency-log witness COSIGNING (ACDP 0.4.0, RFC-ACDP-0015) ---
# Evolves the checkpoint witness above from detect-only into a COSIGNING witness:
# a checkpoint that passes the §7 obligation (signature + consistency from the
# retained head) is cosigned with the witness's OWN Ed25519 assertionMethod key
# and served at GET /log/witness (+ /.well-known/{did.json,acdp-witness.json}).
# Requires LOG_WITNESS_ENABLED=true. A checkpoint that FAILS the obligation is
# never cosigned. The witness key is DEDICATED — never the JWT IdP key (§5/§15).
WITNESS_COSIGNING_ENABLED=false
# The witness's DID (did:web:<this-CP-host> or did:key). Required when enabled.
WITNESS_ID=
# PEM-encoded Ed25519 private key (e.g. `openssl genpkey -algorithm ed25519`).
# Required when enabled. Multi-line: quote/escape per your process manager.
WITNESS_SIGNING_PRIVATE_KEY_PEM=
# assertionMethod key id (DID URL under WITNESS_ID). Defaults to
# `<WITNESS_ID>#witness-key-1`.
WITNESS_KEY_ID=

# --- Transparency-log witness quorum CONSUMPTION (ACDP 0.4.0, RFC-ACDP-0015 §8) ---
# The mirror of cosigning: instead of MINTING, evaluate the N-witnessed quorum
# over the cosignatures a registry AGGREGATES and serves on GET /log/checkpoint
# (the top-level `witness_signatures` sibling). Each is verified against its
# witness's OWN resolved did:web document; DISTINCT trusted witnesses over the
# exact (log_id, tree_size, root_hash) tuple are counted and recorded on the
# witnessed head. Requires LOG_WITNESS_ENABLED=true (rides the same fetch).
WITNESS_QUORUM_ENABLED=false
# Comma-separated witness DIDs (did:web / did:key) whose cosignatures count.
# A cosignature from any witness NOT listed is verified-but-ignored.
WITNESS_QUORUM_TRUSTED=
# The N in "N-witnessed": meets_quorum flips true at this many DISTINCT trusted
# witnesses over the head tuple.
WITNESS_QUORUM_MIN_WITNESSES=1

# Receipt <-> log inclusion cross-check (RFC-ACDP-0012 §9.1): for stored
# publish events with receipts from log-advertising registries, fetch
# /log/proof?ctx_id=... and verify inclusion against a verified checkpoint.
LOG_INCLUSION_AUDIT_ENABLED=false
LOG_INCLUSION_AUDIT_INTERVAL_SECONDS=300
LOG_INCLUSION_AUDIT_BATCH_SIZE=50
LOG_INCLUSION_AUDIT_LOOKBACK_HOURS=24

# --- OpenTelemetry / logging ---
LOG_LEVEL=info
OTEL_ENABLED=false
OTEL_SERVICE_NAME=acdp-control-plane
OTEL_EXPORTER_OTLP_ENDPOINT=

NODE_ENV=development
